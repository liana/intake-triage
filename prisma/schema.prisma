// Client Intake & Triage — data model. See SPEC.md §5.
// SQLite has no enums and no scalar lists: vocabulary columns are String and
// `constraints` is a JSON string parsed at the boundary with Zod.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Intake {
  id                String   @id @default(cuid())
  submitterName     String
  contactEmail      String
  companyName       String
  title             String
  description       String
  industry          String
  budgetRange       String
  timeline          String
  summary           String?
  technicalPattern  String?
  engagementShape   String?
  primaryConstraint String?
  overallRisk       String?
  constraints       String?
  recommendedAction String?
  createdAt         DateTime @default(now())
}
